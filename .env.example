# Скопируйте в .env и заполните локально. Файл .env в git не входит.

# Рабочая SQLite. Пусто — data/observations/sitewatch.db (тоже не в git).
# SITEWATCH_DB_PATH=

# Детектор demo. Реальный YOLO требует веса вне репозитория.
# SITEWATCH_DETECTOR=annotation
# SITEWATCH_YOLO_WEIGHTS=
# SITEWATCH_YOLO_DEVICE=cpu

# Perception. По умолчанию annotation. real — экспериментальный контур, не production.
# SITEWATCH_PERCEPTION_MODE=annotation
# SITEWATCH_SAM3_ENABLED=0
# SITEWATCH_SAM3_DEVICE=cpu
# SITEWATCH_SAM3_CHECKPOINT=
# SITEWATCH_GROUNDING_DINO_ENABLED=0
# SITEWATCH_QWEN_VL_ENABLED=0
# SITEWATCH_QWEN_VL_BASE_URL=http://127.0.0.1:8001/v1
# SITEWATCH_QWEN_VL_MODEL=Qwen/Qwen3-VL-8B-Instruct
# SITEWATCH_QWEN_VL_API_KEY=

# Теневые кандидаты выключены, пока флаг не задан и config/shadow_candidates.yaml enabled: false.
# SITEWATCH_SHADOW_CANDIDATES=0

# Цикл съёмки камер в sitewatch ui. В pytest цикл выключен.
# SITEWATCH_CAPTURE_LOOP=0

# Локальный путь к справочнику работ ДГП (xlsx в репозиторий не класть).
# SITEWATCH_CONSTRUCTION_XLSX=

# Платные VLM-сравнения. Имя переменной совпадает с config/vlm_compare*.yaml.
# OPENROUTR_KEY=
