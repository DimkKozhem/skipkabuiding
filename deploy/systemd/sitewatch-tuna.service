[Unit]
Description=Tuna tunnel skipkabuiding.ru.tuna.am → 127.0.0.1:8000
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/home/dimk/my_project/LCT2026/deploy/systemd/tuna-loop.sh
Restart=always
RestartSec=2
TimeoutStopSec=50
KillMode=control-group
KillSignal=SIGTERM
Environment=HOME=/home/dimk
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=TUNA_BIN=/usr/bin/tuna
Environment=TUNA_PORT=8000
Environment=TUNA_SUBDOMAIN=skipkabuiding
Environment=TUNA_LOCATION=ru
Environment=TUNA_HEALTH_URL=http://127.0.0.1:8000/health
Environment=TUNA_PUBLIC_HOST=skipkabuiding.ru.tuna.am
Environment=TUNA_PUBLIC_HEALTH=https://skipkabuiding.ru.tuna.am/health
Environment=TUNA_LOG=/tmp/sitewatch-tuna.log
Environment=TUNA_RESOLV_FILE=/tmp/sitewatch-tuna-resolv.conf
Environment=TUNA_CHECK_EVERY=10
Environment=TUNA_FAILS_MAX=4
Environment=TUNA_START_GRACE=25
Environment=HTTP_PROXY=
Environment=HTTPS_PROXY=
Environment=ALL_PROXY=
Environment=http_proxy=
Environment=https_proxy=
Environment=all_proxy=

[Install]
WantedBy=default.target
